{
  "name": "beanyou",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy": "echo \"Deploys run in CI on push to main (.github/workflows/deploy.yml). For a manual upload see infra/DEPLOY.md\" && exit 1",
    "format": "prettier --write .",
    "zip": "npm run build && cd out && zip -r ../beanyou-site.zip . -x \"*.DS_Store\" && echo \"Created beanyou-site.zip - upload and extract in cPanel File Manager\""
  },
  "dependencies": {
    "aos": "^2.3.4",
    "clsx": "^2.1.1",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/aos": "^3.0.7",
    "@types/node": "20.19.10",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
