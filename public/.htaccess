# Bean You - Apache config for GoDaddy cPanel hosting.
#
# This file is copied verbatim into the static export (out/.htaccess) and must
# sit in the web root alongside index.html.
#
# Next is built with trailingSlash: true, so every route is a real directory
# containing index.html. Apache's DirectoryIndex + DirectorySlash resolve those
# natively - no rewrite rules needed for routing.

DirectoryIndex index.html
DirectorySlash On
Options -Indexes

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Force HTTPS and a single canonical host
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # GoDaddy terminates TLS at a proxy, so %{HTTPS} alone is not reliable.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www -> apex. Flip this block if you'd rather standardise on www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Append the trailing slash ourselves. mod_dir's DirectorySlash would do it,
  # but behind GoDaddy's TLS-terminating proxy it builds an http:// URL, which
  # downgrades the scheme and costs an extra redirect hop.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L]
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Already-compressed formats gain nothing and waste CPU.
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Files under /_next/static carry a content hash in the filename, so they can
# be cached indefinitely. HTML must revalidate or visitors keep seeing the
# previous deploy.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Security headers. No CSP here - this site loads Google Fonts and inline
  # styles, so a CSP needs to be written and tested deliberately.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 month"
  ExpiresByType image/png                "access plus 1 month"
  ExpiresByType image/webp               "access plus 1 month"
  ExpiresByType image/svg+xml            "access plus 1 month"
  ExpiresByType video/mp4                "access plus 1 month"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Long cache for hashed build output, overriding the generic rules above.
# Uses SetEnvIf rather than <If>, which is Apache 2.4-only and would 500 on
# an older cPanel image.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" LONG_CACHE=1
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE
</IfModule>

# ---------------------------------------------------------------------------
# MIME types - older cPanel images do not always know these
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType video/mp4                   .mp4
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
  AddCharset UTF-8                    .html .css .js .json .xml .svg
</IfModule>
